<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>실시간 매치 · 라인별 대시보드</title>
<link rel="stylesheet" href="/realTimeInfo_styles.css">
</head>
<body>
<div class="match_realTimeInfo">

  <div class="page-head">
    <h1>실시간 매치 · 라인별 대시보드</h1>
    <h2><%= currentDate %> - <%= currentSet %>번째 세트</h2>
  </div>

  <div class="team-bar">
    <div class="team-name blue"><span class="dot"></span>BLUE TEAM</div>
    <div class="vs-label">VS</div>
    <div class="team-name red"><span class="dot"></span>RED TEAM</div>
  </div>

  <div class="board">
    <%
        const blueTop = result?.find(player => player.lane === 'TOP' && player.team === 'BLUE');
        const blueJug = result?.find(player => player.lane === 'JUG' && player.team === 'BLUE');
        const blueMid = result?.find(player => player.lane === 'MID' && player.team === 'BLUE');
        const blueAdc = result?.find(player => player.lane === 'ADC' && player.team === 'BLUE');
        const blueSup = result?.find(player => player.lane === 'SUP' && player.team === 'BLUE');
        const redTop = result?.find(player => player.lane === 'TOP' && player.team === 'RED');
        const redJug = result?.find(player => player.lane === 'JUG' && player.team === 'RED');
        const redMid = result?.find(player => player.lane === 'MID' && player.team === 'RED');
        const redAdc = result?.find(player => player.lane === 'ADC' && player.team === 'RED');
        const redSup = result?.find(player => player.lane === 'SUP' && player.team === 'RED');
        const relativeTop = relative?.find(data => data.lcg_match_line === 'TOP');
        const relativeJug = relative?.find(data => data.lcg_match_line === 'JUG');
        const relativeMid = relative?.find(data => data.lcg_match_line === 'MID');
        const relativeAdc = relative?.find(data => data.lcg_match_line === 'ADC');
        const relativeSup = relative?.find(data => data.lcg_match_line === 'SUP');
    %>

    <!-- TOP -->
    <div class="lane-row">
      <div class="p-card blue" style="--champ-bg:url('https://img.rabbitgang-img.shop/centered/<%= blueTop?.lcg_champion_name %>_0.webp')">
        <div class="p-info">
          <div class="p-names">
            <span class="p-name"><%= blueTop?.lcg_summoner_nickname.split('#')[0] %></span>
            <span class="champ-name"><%= blueTop?.lcg_champion_name %></span>
          </div>
          <div class="p-tags">
            <span class="wl-text"><%= blueTop?.lcg_win_count %>승 <%= blueTop?.lcg_fail_count %>패</span>
            <span class="wl-text"><%= blueTop?.kda %> KDA</span>
          </div>
          <div class="wr-row">
            <div class="wr-track">
              <div class="wr-fill" style="width:<%= blueTop?.rate %>%"></div>
              <span class="wr-pct"><%= blueTop?.rate %>%</span>
            </div>
          </div>
        </div>
      </div>

      <div class="lane-mid">
        <span class="lane-label">TOP</span>
        <div class="h2h-score"><span class="b"><%= relativeTop?.lcg_win_count %></span><span class="sep">:</span><span class="r"><%= relativeTop?.lcg_fail_count %></span></div>
        <div class="h2h-bar" title="상대전적 TOP (블루팀 기준)">
          <div class="seg-b" style="width:<%= relativeTop?.rateBlue %>%"></div>
          <div class="seg-r" style="width:<%= relativeTop?.rateRed %>%"></div>
        </div>
        <span class="h2h-note"><%= relativeTop?.lcg_win_count + relativeTop?.lcg_fail_count %>번째 매치</span>
      </div>

      <div class="p-card red" style="--champ-bg:url('https://img.rabbitgang-img.shop/centered/<%= redTop?.lcg_champion_name %>_0.webp')">
        <div class="p-info">
          <div class="p-names">
            <span class="p-name"><%= redTop?.lcg_summoner_nickname.split('#')[0] %></span>
            <span class="champ-name"><%= redTop?.lcg_champion_name %></span>
          </div>
          <div class="p-tags">
            <span class="wl-text"><%= redTop?.lcg_win_count %>승 <%= redTop?.lcg_fail_count %>패</span>
            <span class="wl-text"><%= redTop?.kda %> KDA</span>
          </div>
          <div class="wr-row">
            <div class="wr-track red">
              <div class="wr-fill red" style="width:<%= redTop?.rate %>%"></div>
